<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Previsão do tempo (Open-Meteo, HTTPS). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Aviso de chuva; permissão em tempo de execução a partir da API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Usar minha localização" no cadastro da propriedade; solicitadas só
         sob ação do usuário. Sem ACCESS_BACKGROUND_LOCATION: uso apenas em primeiro plano. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- GPS opcional: sem ele, localização por rede ou digitação manual. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".AgroSaldoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgroSaldo"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AgroSaldo.Abertura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- O WorkManager é iniciado pelo AgroSaldoApp (Configuration.Provider), com a fábrica de Workers do Hilt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
