<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup automático do Android 6 a 11 (API 23 a 30).

    O banco (conta, propriedades e lançamentos) VAI para o backup: trocar de
    celular não pode apagar o histórico do produtor. A senha está lá só como
    hash PBKDF2, e o backup do Google é criptografado com o bloqueio de tela.

    A sessão e o contador de senhas erradas NÃO vão: no celular novo o app
    pede a senha de novo, e um bloqueio antigo não viaja junto.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sessao.xml" />
    <exclude domain="sharedpref" path="seguranca.xml" />
</full-backup-content>
