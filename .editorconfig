# Regras de formatação lidas pelo ktlint e pelo Android Studio.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Estilo do Android Studio: o mesmo do "Reformat Code" (Ctrl + Alt + L).
ktlint_code_style = android_studio
max_line_length = 140
# Composable é PascalCase (InicioScreen), como manda o guia do Compose.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Nomes de teste em frase, com crase: `saldo e receitas menos despesas`.
ktlint_ignore_back_ticked_identifier = true
# Regras de Compose (io.nlopez.compose.rules): CompositionLocals que o app usa de propósito.
compose_allowed_composition_locals = LocalValoresOcultos,LocalCoresAgro,LocalCoresCategorias
# A multiprévia das telas segue a convenção em português do projeto (@PreviasDaTela, em ui/theme),
# e não o prefixo "Preview" que esta regra exige.
ktlint_compose_preview-annotation-naming = disabled

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
