<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup para API 23 a 30. Manter em sincronia com data_extraction_rules.xml.

    O banco entra no backup (senhas apenas como hash PBKDF2). Ficam de fora a
    sessão (sessao.xml: exige novo login após restauração) e o estado de
    segurança do aparelho (seguranca.xml: tentativas de senha e bloqueio biométrico).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sessao.xml" />
    <exclude domain="sharedpref" path="seguranca.xml" />
</full-backup-content>
