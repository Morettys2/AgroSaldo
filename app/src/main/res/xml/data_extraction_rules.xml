<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup em nuvem e transferência entre aparelhos (API 31+). Mesmas exclusões
    de backup_rules.xml: sessao.xml e seguranca.xml não saem do aparelho.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sessao.xml" />
        <exclude domain="sharedpref" path="seguranca.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sessao.xml" />
        <exclude domain="sharedpref" path="seguranca.xml" />
    </device-transfer>
</data-extraction-rules>
