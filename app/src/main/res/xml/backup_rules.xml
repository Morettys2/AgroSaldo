<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup no Android 8.x (API 26 e 27). Da API 28 à 30 vale
    xml-v28/backup_rules.xml; da API 31 em diante, data_extraction_rules.xml.

    Essas versões não criptografam o backup de ponta a ponta, e o adb backup
    levaria o banco (e-mail, hash da senha, lançamentos e coordenadas) em claro:
    nada do app entra no backup nem na transferência entre aparelhos.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
