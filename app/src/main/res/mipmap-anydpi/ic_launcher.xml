<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone adaptativo: o Android recorta no formato do celular (círculo,
     gota, quadrado). O "monochrome" é usado nos ícones temáticos do Android 13+.
     Com o minSdk 26, a pasta sem versão vale para todos os aparelhos, e o
     qualificador anydpi vence os ícones .webp por densidade. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_agrosaldo_fundo" />
    <foreground android:drawable="@drawable/ic_agrosaldo_broto" />
    <monochrome android:drawable="@drawable/ic_agrosaldo_broto" />
</adaptive-icon>
