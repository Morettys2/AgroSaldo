<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema da janela; cores e tipografia vêm do Compose (ui/theme).

        Precisa herdar de AppCompat: em API 26-27 o androidx.biometric usa
        componentes AppCompat e falha com outro tema. DayNight evita flash
        branco ao abrir no modo escuro.
    -->
    <style name="Theme.AgroSaldo" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!--
        Tema inicial da MainActivity para a splash (core-splashscreen, compatível
        com API < 31). installSplashScreen() troca para postSplashScreenTheme.
    -->
    <style name="Theme.AgroSaldo.Abertura" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/abertura_fundo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_agrosaldo_broto</item>
        <item name="postSplashScreenTheme">@style/Theme.AgroSaldo</item>
    </style>
</resources>
